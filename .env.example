# East Heights Labs — Backend API
# Copy to .env and fill in values. Never commit .env.

# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eastheightslabs

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs — Live Near Me
SONGKICK_API_KEY=
BANDSINTOWN_APP_ID=
